@model IEnumerable<Biblioteca.Models.Book>
@{
    ViewData["Title"] = "Libros";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Listado de Libros</h1>
    <a asp-action="Create" class="btn btn-primary">
        + Nuevo Libro
    </a>
</div>

@if (Model.Any())
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <img src="@ImageUrl(item.ImagePath)"
                         alt="@item.Name"
                         class="card-img-top"
                         style="height: 280px; object-fit: cover;" />
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title mb-1">@item.Name</h5>
                        <p class="card-text text-muted small mb-1">@item.Author</p>
                        <p class="card-text"><small class="text-muted">@item.Category</small></p>
                        <div class="mt-auto">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="h5 mb-0">@item.Price.ToString("C")</span>
                                @if (item.IsAvailable)
                                {
                                    <span class="badge bg-success">Disponible</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">No disponible</span>
                                }
                            </div>
                            <div class="d-grid gap-2 d-md-flex">
                                <a asp-action="Details" asp-route-id="@item.ID" class="btn btn-sm btn-info text-white">Ver</a>
                                <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-sm btn-warning">Editar</a>
                                <a asp-action="Delete" asp-route-id="@item.ID" class="btn btn-sm btn-danger">Eliminar</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body">
            <div class="alert alert-info mb-0" role="alert">
                No hay libros cargados todavía.
            </div>
        </div>
    </div>
}

@functions {
    string ImageUrl(string? path)
        => string.IsNullOrEmpty(path)
            ? Url.Content("~/images/no-image.svg")
            : Url.Content("~/images/" + path);
}
