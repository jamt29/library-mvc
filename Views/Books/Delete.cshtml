@model Biblioteca.Models.Book
@{
    ViewData["Title"] = "Eliminar Libro";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Eliminar Libro</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Volver al listado</a>
</div>

<div class="card shadow-sm border-danger">
    <div class="card-body">
        <div class="alert alert-danger" role="alert">
            <h4 class="alert-heading">¿Estás seguro?</h4>
            <p class="mb-0">Esta acción no se puede deshacer. El libro y su imagen se eliminarán permanentemente.</p>
        </div>

        <div class="row mb-3">
            <div class="col-md-4 text-center">
                <img src="@ImageUrl(Model.ImagePath)"
                     alt="@Model.Name"
                     class="img-thumbnail"
                     style="max-height: 220px; object-fit: cover;" />
            </div>
            <div class="col-md-8">
                <dl class="row mb-0">
                    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Name)</dt>
                    <dd class="col-sm-9">@Model.Name</dd>

                    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Author)</dt>
                    <dd class="col-sm-9">@Model.Author</dd>

                    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Category)</dt>
                    <dd class="col-sm-9">@Model.Category</dd>

                    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Price)</dt>
                    <dd class="col-sm-9">@Model.Price.ToString("C")</dd>
                </dl>
            </div>
        </div>

        <form asp-action="Delete">
            <input type="hidden" asp-for="ID" />
            <button type="submit" class="btn btn-danger">Eliminar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
</div>

@functions {
    string ImageUrl(string? path)
        => string.IsNullOrEmpty(path)
            ? Url.Content("~/images/no-image.svg")
            : Url.Content("~/images/" + path);
}
