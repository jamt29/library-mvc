@model Biblioteca.Models.RegisterViewModel
@{
    ViewData["Title"] = "Crear cuenta";
}

<div class="biblio-home">
    <section class="biblio-section mb-4">
        <div class="row justify-content-center">
            <div class="col-md-7 col-lg-5">
                <div class="auth-card">
                    <div class="auth-card__header">
                        <span class="auth-card__icon"><partial name="_Icon" model="@("people")" /></span>
                        <h1 class="auth-card__title">Crear cuenta</h1>
                        <p class="auth-card__subtitle">Sumate a la biblioteca y empezá a gestionar el catálogo.</p>
                    </div>

                    <form asp-action="Register" method="post">
                        <div asp-validation-summary="ModelOnly" class="auth-validation-summary"></div>

                        <div class="mb-3">
                            <label asp-for="Usuario" class="form-label auth-label"></label>
                            <input asp-for="Usuario" class="form-control" placeholder="Ej. estudiante" autocomplete="username" />
                            <span asp-validation-for="Usuario" class="text-danger auth-field-error"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Correo" class="form-label auth-label"></label>
                            <input asp-for="Correo" class="form-control" placeholder="Ej. estudiante@uees.edu.ec" autocomplete="email" />
                            <span asp-validation-for="Correo" class="text-danger auth-field-error"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Contrasena" class="form-label auth-label"></label>
                            <input asp-for="Contrasena" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="Contrasena" class="text-danger auth-field-error"></span>
                        </div>

                        <div class="auth-hint">
                            <span class="fw-semibold">La contraseña debe incluir:</span>
                            <ul>
                                <li>Mínimo 6 caracteres.</li>
                                <li>Al menos una letra mayúscula.</li>
                                <li>Al menos una letra minúscula.</li>
                                <li>Al menos un número.</li>
                                <li>Al menos un carácter especial.</li>
                            </ul>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmarContrasena" class="form-label auth-label"></label>
                            <input asp-for="ConfirmarContrasena" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmarContrasena" class="text-danger auth-field-error"></span>
                        </div>

                        <button type="submit" class="btn btn-accent auth-submit">Crear cuenta</button>
                    </form>

                    <p class="auth-links mb-0">
                        ¿Ya tenés cuenta? <a asp-action="Login">Iniciá sesión</a>
                    </p>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
