@{
    ViewData["Title"] = "Acceso denegado";
    var autenticado = User.Identity?.IsAuthenticated == true;
}

<div class="biblio-home">
    <section class="biblio-section mb-4">
        <div class="row justify-content-center">
            <div class="col-md-7 col-lg-5">
                <div class="auth-card">
                    <div class="auth-card__header">
                        <span class="auth-card__icon"><partial name="_Icon" model="@("door")" /></span>
                        <h1 class="auth-card__title">Acceso denegado</h1>
                        <p class="auth-card__subtitle">Tu cuenta no tiene permisos para realizar esta operación.</p>
                    </div>

                    <div class="alert alert-danger" role="alert">
                        @if (autenticado)
                        {
                            <text>
                                Iniciaste sesión correctamente, pero esta acción está reservada para los roles
                                <strong>Admin</strong> y <strong>Bibliotecario</strong>. Con tu rol actual todavía podés consultar el catálogo.
                            </text>
                        }
                        else
                        {
                            <text>
                                Necesitás iniciar sesión con una cuenta que tenga permisos para realizar
                                esta operación.
                            </text>
                        }
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <a asp-controller="Libros" asp-action="Index" class="btn btn-accent">Ir al catálogo</a>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-accent">Volver al inicio</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
