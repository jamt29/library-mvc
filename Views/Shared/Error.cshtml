@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    var status = StatusMessageFactory.ForHttpStatus(Model.StatusCode, Model.RequestId, Url);
}

<div class="biblio-home status-page">
    <section class="status-hero" role="banner">
        <div class="status-hero__inner">
            <span class="status-hero__icon" aria-hidden="true">
                <partial name="_Icon" model="@("open-book")" />
            </span>
            <p class="status-hero__kicker">Biblioteca · Sistema de gestión</p>
            <h1 class="status-hero__title">Algo se salió del estante</h1>
            <p class="status-hero__lead">
                La página que intentaste abrir no pudo mostrarse, pero el resto de la biblioteca
                sigue disponible para seguir consultando.
            </p>
        </div>
    </section>

    <section class="biblio-section">
        <div class="row justify-content-center">
            <div class="col-lg-9">
                @await Component.InvokeAsync("StatusMessage", new { model = status })
            </div>
        </div>

        <div class="row row-cols-1 row-cols-md-3 g-4 status-suggestions">
            <div class="col">
                <article class="card status-suggestion h-100">
                    <div class="card-body">
                        <span class="status-suggestion__icon" aria-hidden="true">
                            <partial name="_Icon" model="@("refresh")" />
                        </span>
                        <h3 class="status-suggestion__title">Reintentá la operación</h3>
                        <p class="status-suggestion__text">
                            La mayoría de los casos se resuelven al repetir la acción unos segundos después.
                        </p>
                    </div>
                </article>
            </div>
            <div class="col">
                <article class="card status-suggestion h-100">
                    <div class="card-body">
                        <span class="status-suggestion__icon" aria-hidden="true">
                            <partial name="_Icon" model="@("book")" />
                        </span>
                        <h3 class="status-suggestion__title">Volvé al catálogo</h3>
                        <p class="status-suggestion__text">
                            Encontrá títulos, autores y categorías con los filtros de búsqueda del catálogo.
                        </p>
                    </div>
                </article>
            </div>
            <div class="col">
                <article class="card status-suggestion h-100">
                    <div class="card-body">
                        <span class="status-suggestion__icon" aria-hidden="true">
                            <partial name="_Icon" model="@("people")" />
                        </span>
                        <h3 class="status-suggestion__title">Pedí ayuda</h3>
                        <p class="status-suggestion__text">
                            Si el problema sigue vigente, comunicate con el personal de la biblioteca y
                            compartí el identificador de la petición.
                        </p>
                    </div>
                </article>
            </div>
        </div>
    </section>
</div>
