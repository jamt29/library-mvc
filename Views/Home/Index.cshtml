@{
    ViewData["Title"] = "Inicio";
}

<div class="biblio-home">
    <div id="heroCarousel" class="carousel slide mb-5" data-bs-ride="carousel">
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
        </div>
        <div class="carousel-inner rounded-3 shadow">
            <div class="carousel-item active">
                <div class="hero-slide hero-slide-1">
                    <div class="hero-slide__inner">
                        <h1 class="display-5 fw-bold">Bienvenido a la Biblioteca Virtual</h1>
                        <p class="lead">Miles de libros, autores y categorías a un clic de distancia.</p>
                        <a asp-controller="Libros" asp-action="Index" class="btn btn-light btn-lg mt-2">Explorar catálogo</a>
                    </div>
                </div>
            </div>
            <div class="carousel-item">
                <div class="hero-slide hero-slide-2">
                    <div class="hero-slide__inner">
                        <h2 class="display-6 fw-bold">Nuevos títulos cada semana</h2>
                        <p class="lead">Mantenete al día con las últimas incorporaciones de nuestro catálogo.</p>
                        <a asp-controller="Categorias" asp-action="Index" class="btn btn-light btn-lg mt-2">Ver categorías</a>
                    </div>
                </div>
            </div>
            <div class="carousel-item">
                <div class="hero-slide hero-slide-3">
                    <div class="hero-slide__inner">
                        <h2 class="display-6 fw-bold">Un club de lectura para cada gusto</h2>
                        <p class="lead">Sumate a nuestras actividades y descubrí nuevos autores.</p>
                        <a asp-controller="Home" asp-action="About" class="btn btn-light btn-lg mt-2">Conocer más</a>
                    </div>
                </div>
            </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Anterior</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Siguiente</span>
        </button>
    </div>

    <div class="alert alert-biblio alert-dismissible fade show" role="alert">
        <div class="alert-biblio__inner">
            <span class="icon-inline alert-biblio__icon"><partial name="_Icon" model="@("book")" /></span>
            <div class="alert-biblio__text">
                <strong>¡Nueva colección disponible!</strong> Se incorporaron títulos de literatura latinoamericana y ciencia ficción.
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    </div>

    <section class="stats-section" aria-label="Estadísticas de la biblioteca">
        <h2 class="visually-hidden">Cifras destacadas</h2>
        <div class="flex-stat-row">
            <article class="card stat-card stat-card--books">
                <div class="card-body">
                    <div class="stat-card__value">1,240</div>
                    <div class="stat-card__label">Libros</div>
                </div>
            </article>
            <article class="card stat-card stat-card--authors">
                <div class="card-body">
                    <div class="stat-card__value">310</div>
                    <div class="stat-card__label">Autores</div>
                </div>
            </article>
            <article class="card stat-card stat-card--categories">
                <div class="card-body">
                    <div class="stat-card__value">18</div>
                    <div class="stat-card__label">Categorías</div>
                </div>
            </article>
            <article class="card stat-card stat-card--users">
                <div class="card-body">
                    <div class="stat-card__value">2,050</div>
                    <div class="stat-card__label">Usuarios activos</div>
                </div>
            </article>
        </div>
    </section>

    <section class="biblio-section" aria-labelledby="categorias-titulo">
        <div class="section-header">
            <h2 class="section-title" id="categorias-titulo">Explorá por categorías</h2>
            <a asp-controller="Categorias" asp-action="Index" class="btn btn-outline-accent btn-sm">Ver todas</a>
        </div>
        <div class="flex-category-row">
            <article class="card category-card">
                <div class="card-body">
                    <div class="icon-lg"><partial name="_Icon" model="@("open-book")" /></div>
                    <h3 class="h6 mt-2">Ficción</h3>
                    <span class="badge text-bg-secondary">320 libros</span>
                </div>
            </article>
            <article class="card category-card">
                <div class="card-body">
                    <div class="icon-lg"><partial name="_Icon" model="@("flask")" /></div>
                    <h3 class="h6 mt-2">Ciencia y Tecnología</h3>
                    <span class="badge text-bg-secondary">180 libros</span>
                </div>
            </article>
            <article class="card category-card">
                <div class="card-body">
                    <div class="icon-lg"><partial name="_Icon" model="@("landmark")" /></div>
                    <h3 class="h6 mt-2">Historia</h3>
                    <span class="badge text-bg-secondary">210 libros</span>
                </div>
            </article>
            <article class="card category-card">
                <div class="card-body">
                    <div class="icon-lg"><partial name="_Icon" model="@("star")" /></div>
                    <h3 class="h6 mt-2">Infantil</h3>
                    <span class="badge text-bg-secondary">150 libros</span>
                </div>
            </article>
        </div>
    </section>

    <section class="biblio-section biblio-grid-section" aria-labelledby="panel-titulo">
        <div class="section-header">
            <h2 class="section-title" id="panel-titulo">La Biblioteca Virtual en cifras</h2>
            <a asp-controller="Home" asp-action="About" class="btn btn-outline-accent btn-sm">Conocé más</a>
        </div>
        <div class="biblio-grid">
            <article class="grid-tile grid-tile--featured">
                <div class="grid-tile__badge">Destacado</div>
                <h3 class="grid-tile__title">Catálogo en línea</h3>
                <p class="grid-tile__text">Más de 1,200 títulos digitales disponibles las 24 horas, sin necesidad de registrarte.</p>
                <div class="grid-tile__icon"><partial name="_Icon" model="@("book")" /></div>
            </article>
            <article class="grid-tile grid-tile--authors">
                <h3 class="grid-tile__title">Autores</h3>
                <p class="grid-tile__text">310 perfiles nacionales e internacionales con sus obras más relevantes.</p>
                <div class="grid-tile__count">310</div>
            </article>
            <article class="grid-tile grid-tile--categories">
                <h3 class="grid-tile__title">Categorías</h3>
                <p class="grid-tile__text">18 áreas temáticas para encontrar tu próxima lectura en segundos.</p>
                <div class="grid-tile__count">18</div>
            </article>
            <article class="grid-tile grid-tile--loans">
                <h3 class="grid-tile__title">Préstamos activos</h3>
                <p class="grid-tile__text">Renová online y retirá en sucursal o pedí envío a domicilio.</p>
                <div class="grid-tile__count">487</div>
            </article>
            <article class="grid-tile grid-tile--digital">
                <h3 class="grid-tile__title">Recursos digitales</h3>
                <p class="grid-tile__text">e-books, audiolibros y bases de datos académicas en un solo lugar.</p>
                <div class="grid-tile__icon"><partial name="_Icon" model="@("laptop")" /></div>
            </article>
            <article class="grid-tile grid-tile--events">
                <h3 class="grid-tile__title">Eventos del mes</h3>
                <p class="grid-tile__text">Club de lectura, talleres y presentaciones con autores invitados.</p>
                <div class="grid-tile__count">12</div>
            </article>
        </div>
    </section>

    <section class="biblio-section" aria-labelledby="destacados-titulo">
        <div class="section-header">
            <h2 class="section-title" id="destacados-titulo">Libros destacados</h2>
            <a asp-controller="Libros" asp-action="Index" class="btn btn-outline-accent btn-sm">Ver catálogo</a>
        </div>
        <div class="flex-book-row">
            <article class="card book-card">
                <div class="book-card__media">
                    <img src="~/images/no-image.svg" alt="Portada de Cien Años de Soledad">
                </div>
                <div class="card-body">
                    <span class="badge book-badge book-badge--popular">Popular</span>
                    <h3 class="h6 card-title mt-2">Cien Años de Soledad</h3>
                    <p class="card-text text-muted small">Gabriel García Márquez</p>
                </div>
                <div class="card-footer bg-transparent border-0">
                    <a asp-controller="Libros" asp-action="Index" class="btn btn-sm btn-accent w-100">Ver más</a>
                </div>
            </article>
            <article class="card book-card">
                <div class="book-card__media">
                    <img src="~/images/no-image.svg" alt="Portada de Don Quijote de la Mancha">
                </div>
                <div class="card-body">
                    <span class="badge book-badge book-badge--classic">Clásico</span>
                    <h3 class="h6 card-title mt-2">Don Quijote de la Mancha</h3>
                    <p class="card-text text-muted small">Miguel de Cervantes</p>
                </div>
                <div class="card-footer bg-transparent border-0">
                    <a asp-controller="Libros" asp-action="Index" class="btn btn-sm btn-accent w-100">Ver más</a>
                </div>
            </article>
            <article class="card book-card">
                <div class="book-card__media">
                    <img src="~/images/no-image.svg" alt="Portada de 1984">
                </div>
                <div class="card-body">
                    <span class="badge book-badge book-badge--new">Nuevo</span>
                    <h3 class="h6 card-title mt-2">1984</h3>
                    <p class="card-text text-muted small">George Orwell</p>
                </div>
                <div class="card-footer bg-transparent border-0">
                    <a asp-controller="Libros" asp-action="Index" class="btn btn-sm btn-accent w-100">Ver más</a>
                </div>
            </article>
            <article class="card book-card">
                <div class="book-card__media">
                    <img src="~/images/no-image.svg" alt="Portada de El Principito">
                </div>
                <div class="card-body">
                    <span class="badge book-badge book-badge--new">Nuevo</span>
                    <h3 class="h6 card-title mt-2">El Principito</h3>
                    <p class="card-text text-muted small">Antoine de Saint-Exupéry</p>
                </div>
                <div class="card-footer bg-transparent border-0">
                    <a asp-controller="Libros" asp-action="Index" class="btn btn-sm btn-accent w-100">Ver más</a>
                </div>
            </article>
        </div>
    </section>

    <section class="biblio-section" aria-labelledby="servicios-titulo">
        <h2 class="section-title" id="servicios-titulo">Servicios de la biblioteca</h2>
        <div class="accordion services-accordion" id="serviciosAccordion">
            <div class="accordion-item">
                <h3 class="accordion-header">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#servicio1" aria-expanded="true" aria-controls="servicio1">
                        <span class="icon-inline me-2"><partial name="_Icon" model="@("box")" /></span> Préstamo de libros
                    </button>
                </h3>
                <div id="servicio1" class="accordion-collapse collapse show" data-bs-parent="#serviciosAccordion">
                    <div class="accordion-body">
                        Retirá hasta 3 libros por 15 días, con opción a renovación si nadie más lo solicitó.
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h3 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#servicio2" aria-expanded="false" aria-controls="servicio2">
                        <span class="icon-inline me-2"><partial name="_Icon" model="@("door")" /></span> Sala de lectura y estudio
                    </button>
                </h3>
                <div id="servicio2" class="accordion-collapse collapse" data-bs-parent="#serviciosAccordion">
                    <div class="accordion-body">
                        Espacios individuales y grupales disponibles de lunes a sábado, con reserva previa.
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h3 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#servicio3" aria-expanded="false" aria-controls="servicio3">
                        <span class="icon-inline me-2"><partial name="_Icon" model="@("laptop")" /></span> Recursos digitales
                    </button>
                </h3>
                <div id="servicio3" class="accordion-collapse collapse" data-bs-parent="#serviciosAccordion">
                    <div class="accordion-body">
                        Acceso a e-books, bases de datos académicas y revistas científicas desde cualquier dispositivo.
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h3 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#servicio4" aria-expanded="false" aria-controls="servicio4">
                        <span class="icon-inline me-2"><partial name="_Icon" model="@("person")" /></span> Asesoría bibliográfica
                    </button>
                </h3>
                <div id="servicio4" class="accordion-collapse collapse" data-bs-parent="#serviciosAccordion">
                    <div class="accordion-body">
                        Nuestro equipo de bibliotecarios te ayuda a encontrar fuentes confiables para tus investigaciones.
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="cta-section">
        <h2 class="section-title section-title--center">¿Listo para tu próxima lectura?</h2>
        <p class="cta-section__lead">Sumate a la comunidad de la Biblioteca Virtual y descubrí tu próximo libro favorito.</p>
        <div class="cta-section__buttons">
            <a asp-controller="Libros" asp-action="Index" class="btn btn-accent btn-lg">Ver catálogo de libros</a>
            <a asp-controller="Home" asp-action="About" class="btn btn-outline-secondary btn-lg">Conocé más sobre nosotros</a>
        </div>
    </section>
</div>
