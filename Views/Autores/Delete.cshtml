@model Biblioteca.Models.Author
@{
    ViewData["Title"] = "Eliminar Autor";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Eliminar Autor</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Volver al listado</a>
</div>

<div class="card shadow-sm border-danger">
    <div class="card-body">
        <div class="alert alert-danger" role="alert">
            <h4 class="alert-heading">¿Estás seguro?</h4>
            <p class="mb-0">Esta acción no se puede deshacer. El autor se eliminará permanentemente de la lista.</p>
        </div>

        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Name)</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Surname)</dt>
            <dd class="col-sm-9">@Model.Surname</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Nationality)</dt>
            <dd class="col-sm-9">@Model.Nationality</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.BirthDate)</dt>
            <dd class="col-sm-9">@Model.BirthDate.ToString("dd/MM/yyyy")</dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="ID" />
            <button type="submit" class="btn btn-danger">Eliminar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
</div>
