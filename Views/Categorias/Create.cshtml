@model Biblioteca.Models.Categoria
@{
    ViewData["Title"] = "Nueva Categoría";
}

<div class="biblio-home">
    <section class="biblio-section mb-4">
        <div class="section-header">
            <div>
                <h1 class="section-title">Nueva Categoría</h1>
                <p class="text-muted mb-0">Registrá una nueva temática para organizar el catálogo de libros</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-accent">
                &larr; Volver al listado
            </a>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="biblio-form-card">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Nombre" class="form-label fw-bold" style="color: var(--biblio-ink);"></label>
                            <input asp-for="Nombre" class="form-control" placeholder="Ej. Novela Contemporánea, Ensayo Filosófico..." />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Descripcion" class="form-label fw-bold" style="color: var(--biblio-ink);">Descripción</label>
                            <textarea asp-for="Descripcion" class="form-control" rows="4" placeholder="Describí brevemente el alcance de esta categoría temática..."></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2 pt-2 border-top" style="border-color: var(--biblio-paper-dark) !important;">
                            <button type="submit" class="btn btn-accent">
                                <span class="icon-inline me-1"><partial name="_Icon" model="@("folder")" /></span> Guardar categoría
                            </button>
                            <a asp-action="Index" class="btn btn-outline-accent">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
