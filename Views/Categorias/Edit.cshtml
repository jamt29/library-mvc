@model Biblioteca.Models.Categoria
@{
    ViewData["Title"] = "Editar Categoría";
}

<div class="biblio-home">
    <section class="biblio-section mb-4">
        <div class="section-header">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <h1 class="section-title mb-0">Editar Categoría</h1>
                    <span class="badge category-badge-id px-2 py-1">ID #@Model.Id</span>
                </div>
                <p class="text-muted mb-0">Modificá los datos de la categoría en la base de datos</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-accent">
                &larr; Volver al listado
            </a>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="biblio-form-card">
                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label asp-for="Nombre" class="form-label fw-bold" style="color: var(--biblio-ink);"></label>
                            <input asp-for="Nombre" class="form-control" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Descripcion" class="form-label fw-bold" style="color: var(--biblio-ink);">Descripción</label>
                            <textarea asp-for="Descripcion" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2 pt-2 border-top" style="border-color: var(--biblio-paper-dark) !important;">
                            <button type="submit" class="btn btn-accent">
                                Guardar cambios
                            </button>
                            <a asp-action="Index" class="btn btn-outline-accent">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
